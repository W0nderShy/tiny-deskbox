<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 统一深色主题 -->
    <Color x:Key="DeskBox.SurfaceColor">#2D2D30</Color>
    <Color x:Key="DeskBox.TitleBarColor">#3C3C3C</Color>
    <Color x:Key="DeskBox.BorderColor">#505050</Color>
    <Color x:Key="DeskBox.AccentColor">#4A9EFF</Color>
    <Color x:Key="DeskBox.ButtonColor">#464649</Color>
    <Color x:Key="DeskBox.ButtonHoverColor">#56565A</Color>
    <Color x:Key="DeskBox.TextPrimaryColor">#E8E8E8</Color>
    <Color x:Key="DeskBox.TextMutedColor">#9A9A9A</Color>
    <Color x:Key="DeskBox.ThumbColor">#6A6A6E</Color>

    <SolidColorBrush x:Key="DeskBox.SurfaceBrush" Color="{StaticResource DeskBox.SurfaceColor}"/>
    <SolidColorBrush x:Key="DeskBox.TitleBarBrush" Color="{StaticResource DeskBox.TitleBarColor}"/>
    <SolidColorBrush x:Key="DeskBox.BorderBrush" Color="{StaticResource DeskBox.BorderColor}"/>
    <SolidColorBrush x:Key="DeskBox.AccentBrush" Color="{StaticResource DeskBox.AccentColor}"/>
    <SolidColorBrush x:Key="DeskBox.ButtonBrush" Color="{StaticResource DeskBox.ButtonColor}"/>
    <SolidColorBrush x:Key="DeskBox.ButtonHoverBrush" Color="{StaticResource DeskBox.ButtonHoverColor}"/>
    <SolidColorBrush x:Key="DeskBox.TextPrimaryBrush" Color="{StaticResource DeskBox.TextPrimaryColor}"/>
    <SolidColorBrush x:Key="DeskBox.TextMutedBrush" Color="{StaticResource DeskBox.TextMutedColor}"/>
    <SolidColorBrush x:Key="DeskBox.ThumbBrush" Color="{StaticResource DeskBox.ThumbColor}"/>

    <Style x:Key="DeskBox.TitleButton" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="4,0,0,0"/>
        <Setter Property="Foreground" Value="{StaticResource DeskBox.TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource DeskBox.ButtonBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DeskBox.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DeskBox.ButtonHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeskBox.ResizeThumb" TargetType="Thumb">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Opacity" Value="0.001"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
    </Style>
</ResourceDictionary>
