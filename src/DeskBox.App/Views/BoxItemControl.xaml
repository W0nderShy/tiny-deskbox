<UserControl x:Class="DeskBox.App.Views.BoxItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="72" Margin="4">
    <StackPanel>
        <Image Source="{Binding Icon}" Width="48" Height="48" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" TextWrapping="Wrap"
                   MaxWidth="72" Foreground="{StaticResource DeskBox.TextPrimaryBrush}"
                   FontSize="11" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
