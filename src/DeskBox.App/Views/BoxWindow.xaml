<Window x:Class="DeskBox.App.Views.BoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskBox.App.Views"
        Title="DeskBox"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        MinWidth="160"
        MinHeight="32">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:BoxItemViewModel}">
            <local:BoxItemControl />
        </DataTemplate>
    </Window.Resources>
    <Border x:Name="RootBorder" CornerRadius="8" BorderThickness="1"
            BorderBrush="{StaticResource DeskBox.BorderBrush}"
            Background="{StaticResource DeskBox.SurfaceBrush}" Padding="0"
            MouseEnter="BoxWindow_MouseEnter" MouseLeave="BoxWindow_MouseLeave">
        <Grid>
            <Grid x:Name="MainPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition x:Name="ContentRow" Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="{StaticResource DeskBox.TitleBarBrush}"
                    BorderThickness="0"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{StaticResource DeskBox.TextPrimaryBrush}"
                               FontSize="13" TextTrimming="CharacterEllipsis"
                               MouseLeftButtonDown="TitleText_MouseLeftButtonDown"/>
                    <Button x:Name="CollapseButton" Grid.Column="1" Content="−"
                            Style="{StaticResource DeskBox.TitleButton}"
                            Click="CollapseButton_Click" ToolTip="固定展开/收起"/>
                    <Button Grid.Column="2" Content="×" Style="{StaticResource DeskBox.TitleButton}"
                            Click="CloseButton_Click" ToolTip="删除盒子"/>
                </Grid>
            </Border>

            <ListBox x:Name="ItemsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource DeskBox.TextPrimaryBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     AllowDrop="True" PreviewDragOver="Content_PreviewDragOver" Drop="Content_Drop"
                     MouseDoubleClick="ItemsList_MouseDoubleClick"
                     PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="ItemsList_PreviewMouseMove">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 仅覆盖内容区，避免挡住标题栏拖动与删除按钮 -->
            <Grid x:Name="ResizeChrome" Grid.Row="1" Visibility="Collapsed" Panel.ZIndex="2">
                <Thumb Style="{StaticResource DeskBox.ResizeThumb}"
                       HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6"
                       Cursor="SizeWE" DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeRight_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
                <Thumb Style="{StaticResource DeskBox.ResizeThumb}"
                       HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="6"
                       Cursor="SizeNS" DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeBottom_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
                <Thumb Style="{StaticResource DeskBox.ResizeThumb}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12"
                       Cursor="SizeNWSE" DragStarted="ResizeThumb_DragStarted"
                       DragDelta="ResizeCorner_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
